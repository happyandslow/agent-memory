   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A2 col 127",
   "originalText": "A2 col 127",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "t0049",
   "type": "text",
   "x": 120.0,
   "y": 365.0,
   "width": 287.1,
   "height": 90.0,
   "angle": 0.0,
   "strokeColor": "#172033",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a0049",
   "roundness": null,
   "seed": 1049,
   "version": 1,
   "versionNonce": 2049,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Blue: A1(c=47, y=47)\nOrange: A1(c=127, y=47)\nTwo different source PEs;\nsame physical horizontal row.",
   "originalText": "Blue: A1(c=47, y=47)\nOrange: A1(c=127, y=47)\nTwo different source PEs;\nsame physical horizontal row.",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "t0050",
   "type": "text",
   "x": 895.0,
   "y": 170.0,
   "width": 178.20000000000002,
   "height": 112.5,
   "angle": 0.0,
   "strokeColor": "#172033",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a0050",
   "roundness": null,
   "seed": 1050,
   "version": 1,
   "versionNonce": 2050,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Each payload S[c]:\nQ[c]: 32 elements\nK[c]: 8 elements\nV[c]: 8 elements\n48 elements total",
   "originalText": "Each payload S[c]:\nQ[c]: 32 elements\nK[c]: 8 elements\nV[c]: 8 elements\n48 elements total",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "t0051",
   "type": "text",
   "x": 895.0,
   "y": 300.0,
   "width": 257.40000000000003,
   "height": 90.0,
   "angle": 0.0,
   "strokeColor": "#172033",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a0051",
   "roundness": null,
   "seed": 1051,
   "version": 1,
   "versionNonce": 2051,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "At A2(c,47):\n1. receive into QKV buffer\n2. send on C11\n3. retain local copy",
   "originalText": "At A2(c,47):\n1. receive into QKV buffer\n2. send on C11\n3. retain local copy",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "t0052",
   "type": "text",
   "x": 895.0,
   "y": 410.0,
   "width": 205.70000000000002,
   "height": 106.25,
   "angle": 0.0,
   "strokeColor": "#172033",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a0052",
   "roundness": null,
   "seed": 1052,
   "version": 1,
   "versionNonce": 2052,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "C11 routers multicast:\nlocal PE + next PE.\nSame S[c] reaches all\n256 rows of column c.\nNo merge with S[c' ].",
   "originalText": "C11 routers multicast:\nlocal PE + next PE.\nSame S[c] reaches all\n256 rows of column c.\nNo merge with S[c' ].",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "t0053",
   "type": "text",
   "x": 20.0,
   "y": 650.0,
   "width": 319.0,
   "height": 25.0,
   "angle": 0.0,
   "strokeColor": "#172033",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a0053",
   "roundness": null,
   "seed": 1053,
   "version": 1,
   "versionNonce": 2053,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "GENERAL RULE / boundary cases",
   "originalText": "GENERAL RULE / boundary cases",
   "fontSize": 20,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "t0054",
   "type": "text",
   "x": 20.0,
   "y": 689.0,
   "width": 762.3000000000001,
   "height": 22.5,
   "angle": 0.0,
   "strokeColor": "#172033",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a0054",
   "roundness": null,
   "seed": 1054,
   "version": 1,
   "versionNonce": 2054,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A1(c, c mod 80) --EAST--> A2(c, c mod 80) --NORTH + SOUTH--> A2(c, every row)",
   "originalText": "A1(c, c mod 80) --EAST--> A2(c, c mod 80) --NORTH + SOUTH--> A2(c, every row)",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "t0055",
   "type": "text",
   "x": 20.0,
   "y": 730.0,
   "width": 757.35,
   "height": 21.25,
   "angle": 0.0,
   "strokeColor": "#172033",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a0055",
   "roundness": null,
   "seed": 1055,
   "version": 1,
   "versionNonce": 2055,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "c=0..79 uses C8; c=80..127 uses C9. Horizontal travel preserves column ownership.",
   "originalText": "c=0..79 uses C8; c=80..127 uses C9. Horizontal travel preserves column ownership.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "t0056",
   "type": "text",
   "x": 20.0,
   "y": 765.0,
   "width": 813.45,
   "height": 21.25,
   "angle": 0.0,
   "strokeColor": "#172033",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a0056",
   "roundness": null,
   "seed": 1056,
   "version": 1,
   "versionNonce": 2056,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "c=0 and c=80 arrive at y=0: SOUTH only. Other receiver rows fan out in both directions.",
   "originalText": "c=0 and c=80 arrive at y=0: SOUTH only. Other receiver rows fan out in both directions.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "t0057",
   "type": "text",
   "x": 20.0,
   "y": 800.0,
   "width": 888.2500000000001,
   "height": 21.25,
   "angle": 0.0,
   "strokeColor": "#172033",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a0057",
   "roundness": null,
   "seed": 1057,
   "version": 1,
   "versionNonce": 2057,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Rows 0..47 carry two source payloads; rows 48..79 carry one. Offset strokes above share row 47.",
   "originalText": "Rows 0..47 carry two source payloads; rows 48..79 carry one. Offset strokes above share row 47.",
   "fontSize": 17,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "t0058",
   "type": "text",
   "x": 20.0,
   "y": 845.0,
   "width": 907.5000000000001,
   "height": 18.75,
   "angle": 0.0,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a0058",
   "roundness": null,
   "seed": 1058,
   "version": 1,
   "versionNonce": 2058,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Scope starts after A1 computes QKV. A1 reductions / RoPE and A2 attention collectives are separate operations.",
   "originalText": "Scope starts after A1 computes QKV. A1 reductions / RoPE and A2 attention collectives are separate operations.",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "t0059",
   "type": "text",
   "x": 20.0,
   "y": 887.0,
   "width": 941.6,
   "height": 20.0,
   "angle": 0.0,
   "strokeColor": "#172033",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a0059",
   "roundness": null,
   "seed": 1059,
   "version": 1,
   "versionNonce": 2059,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Before these arrows: 80 A1 rows contribute partial dot-products per column; Y all-reduce produces replicas.",
   "originalText": "Before these arrows: 80 A1 rows contribute partial dot-products per column; Y all-reduce produces replicas.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25,
   "_bold": false
  },
  {
   "id": "t0060",
   "type": "text",
   "x": 20.0,
   "y": 923.0,
   "width": 871.2,
   "height": 20.0,
   "angle": 0.0,
   "strokeColor": "#172033",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a0060",
   "roundness": null,
   "seed": 1060,
   "version": 1,
   "versionNonce": 2060,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "After QK-norm / RoPE: choose ONE ready replica per column to send. 128 columns = 128 QKV injectors.",
   "originalText": "After QK-norm / RoPE: choose ONE ready replica per column to send. 128 columns = 128 QKV injectors.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25,
   "_bold": false
  },
  {
   "id": "t0061",
   "type": "text",
   "x": 20.0,
   "y": 959.0,
   "width": 915.2,
   "height": 20.0,
   "angle": 0.0,
   "strokeColor": "#172033",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a0061",
   "roundness": null,
   "seed": 1061,
   "version": 1,
   "versionNonce": 2061,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The 80 row contributions are summed, not concatenated into 80 payloads. A2 receives one 48-element S[c].",
   "originalText": "The 80 row contributions are summed, not concatenated into 80 payloads. A2 receives one 48-element S[c].",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25,
   "_bold": false
  },
