    {"id":"roles","type":"rectangle","x":1215,"y":500,"width":285,"height":445,"angle":0,"strokeColor":"#475569","backgroundColor":"#f8fafc","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"d6","roundness":{"type":3},"seed":37,"version":1,"versionNonce":37,"isDeleted":false,"boundElements":null,"updated":1787616000000,"link":null,"locked":false},
    {"id":"roles_t","type":"text","x":1235,"y":520,"width":245,"height":402,"angle":0,"strokeColor":"#334155","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"d7","roundness":null,"seed":38,"version":1,"versionNonce":38,"isDeleted":false,"boundElements":null,"updated":1787616000000,"link":null,"locked":false,"text":"OVERLAPPING PE ROLES\n\nBlue: every PE computes\n\nGreen columns:\nX phase-1 roots\nx mod 16 = 8\n\nPurple rows:\nY phase-1 roots\ny mod 16 = 8\n\nOrange cross:\nphase-2 root column / row\n\nRed intersection:\ntimestamp + result sender\n\nScoped Y-band roots:\nFull KV: P/4 band\n  P256 roots 32+64k\nGDN QK: P/16 band\n  P256 roots 8+16k\nGDN value: P/32 band\n  P256 roots 4+8k\n\nAll reduce paths use chain SUM/MAX\nthen router multicast (P-1 + P-2).","fontSize":15,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"OVERLAPPING PE ROLES\n\nBlue: every PE computes\n\nGreen columns:\nX phase-1 roots\nx mod 16 = 8\n\nPurple rows:\nY phase-1 roots\ny mod 16 = 8\n\nOrange cross:\nphase-2 root column / row\n\nRed intersection:\ntimestamp + result sender\n\nScoped Y-band roots:\nFull KV: P/4 band\n  P256 roots 32+64k\nGDN QK: P/16 band\n  P256 roots 8+16k\nGDN value: P/32 band\n  P256 roots 4+8k\n\nAll reduce paths use chain SUM/MAX\nthen router multicast (P-1 + P-2).","autoResize":true,"lineHeight":1.25},

