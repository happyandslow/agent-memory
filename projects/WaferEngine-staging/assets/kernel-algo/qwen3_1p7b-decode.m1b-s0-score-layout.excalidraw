    {"id":"newkt","type":"text","x":880,"y":407,"width":655,"height":175,"angle":0,"strokeColor":"#172033","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b6","roundness":null,"seed":17,"version":1,"versionNonce":117,"isDeleted":false,"boundElements":null,"updated":1787961601000,"link":null,"locked":false,"text":"RIGHT INPUT — XKCache (storage order unchanged)\norder [bsz=2][kv_cols=4][kv_len_per_pe]\n(drawing shows j0 j1 j2 j3; k is the row dimension)\n\nb0, L0=1: each k row [LIVE | tail tail tail]\nb1, L1=3: each k row [LIVE LIVE LIVE | tail]\n\nEach request rebinds the DSD to its own current_len.","fontSize":17,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"RIGHT INPUT — XKCache (storage order unchanged)\norder [bsz=2][kv_cols=4][kv_len_per_pe]\n(drawing shows j0 j1 j2 j3; k is the row dimension)\n\nb0, L0=1: each k row [LIVE | tail tail tail]\nb1, L1=3: each k row [LIVE LIVE LIVE | tail]\n\nEach request rebinds the DSD to its own current_len.","autoResize":true,"lineHeight":1.25},
