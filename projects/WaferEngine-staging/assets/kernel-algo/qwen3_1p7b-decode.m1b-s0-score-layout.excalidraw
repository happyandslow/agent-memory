    {"id":"newot","type":"text","x":880,"y":647,"width":655,"height":155,"angle":0,"strokeColor":"#172033","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b8","roundness":null,"seed":19,"version":2,"versionNonce":219,"isDeleted":false,"boundElements":null,"updated":1788046900000,"link":null,"locked":false,"text":"OUTPUT — fixed G*C segment per request; groups packed inside\nphysical arena [bsz=2][G*C_draw=8]\n\nrequest b0, base 0: [g0:1][g1:1][zero tail:6]\nrequest b1, base 8: [g0:3][g1:3][zero tail:2]\n\ngroup_base = b*G*C + g*current_len","fontSize":17,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"OUTPUT — fixed G*C segment per request; groups packed inside\nphysical arena [bsz=2][G*C_draw=8]\n\nrequest b0, base 0: [g0:1][g1:1][zero tail:6]\nrequest b1, base 8: [g0:3][g1:3][zero tail:2]\n\ngroup_base = b*G*C + g*current_len","autoResize":true,"lineHeight":1.25},
    {"id":"newwhy","type":"text","x":880,"y":855,"width":655,"height":110,"angle":0,"strokeColor":"#14532d","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":null,"index":"b9","roundness":null,"seed":20,"version":2,"versionNonce":220,"isDeleted":false,"boundElements":null,"updated":1788046900000,"link":null,"locked":false,"text":"WHY [1,3] FITS\nRequest bases 0 and 8 never depend on peer lengths.\nInside each request, @map(G) advances by that request's current_len.\nFull-arena zeroing leaves request tails neutral.","fontSize":18,"fontFamily":2,"textAlign":"left","verticalAlign":"top","containerId":null,"originalText":"WHY [1,3] FITS\nRequest bases 0 and 8 never depend on peer lengths.\nInside each request, @map(G) advances by that request's current_len.\nFull-arena zeroing leaves request tails neutral.","autoResize":true,"lineHeight":1.25},
